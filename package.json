{
  "name": "@coding-club/ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build --webpack",
    "start": "next start -p 3005",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/worker/index.ts",
    "operator:add": "node --env-file-if-exists=.env.local --import tsx src/cli/add-operator.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --import tsx --test contracts/log-event-v1/log-event-v1.test.ts",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "lucide-react": "^1.34.0",
    "mongodb": "^7.6.0",
    "next": "16.1.6",
    "pg": "^8.23.0",
    "pm2": "^7.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "redis": "^6.2.1",
    "sass": "^1.103.1",
    "systeminformation": "^5.33.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
