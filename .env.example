DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5433/ops
REDIS_URL=redis://host.docker.internal:6379
MONGODB_URI=mongodb://host.docker.internal:27017/ops?replicaSet=rs0

AUTH_SECRET=replace-with-at-least-32-random-characters
BASE_URL="http://localhost:3005"
TRUSTED_ORIGINS="http://localhost:3005"

AZURE_CLIENT_ID=replace-with-azure-client-id
AZURE_CLIENT_SECRET=replace-with-azure-client-secret
AZURE_TENANT_ID=replace-with-azure-tenant-id

LOG_RETENTION_DAYS=30
LOG_INGEST_SECRET=replace-with-at-least-32-random-characters
LOG_STREAM_KEY="ops:logs:v1"
LOG_LIVE_CHANNEL="ops:logs:live:v1"
LOG_CONSUMER_GROUP="ops-workers-v1"

OPS_SEED_ADMIN_EMAIL=codingclub@iitg.ac.in
